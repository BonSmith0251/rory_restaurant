<?xml version="1.0" encoding="utf-8" standalone="yes"?> 
<Settings xmlns="http://origamingmedia.com"> 
	<Product>
		<!-- Specify Game Name -->
		<Name>Rory's Restaurant</Name>
		
		<!-- Specify Game Version -->
		<Version>1.0.2</Version>
		
		<!-- Specify Game PackageName -->
		<PackageName>com.tamalaki.rorysrestaurant</PackageName>
				
		<!-- Specify Game Texture Size: 'sd', 'hd', 'all' ('ld' and 'xhd' will be added later)-->
		<TextureSize>hd</TextureSize>
		
		<!-- Specify Game Embed Mode -->
		<EmbedAssets>false</EmbedAssets>
		
		<!-- Specify Game Encrypt Assets -->
		<EncryptAssets>false</EncryptAssets>
		
		<!-- Specify Game handling Deactivate Event (default = false)
			Only add these events: Event.ACTIVATE and Event.DEACTIVATE 
			when this is true -->
		<handleDeactivateEvent>true</handleDeactivateEvent>
	</Product>
	
	<Publishing>
		<Platform>Desktop</Platform>
		<Publisher>BFG</Publisher> 
		<NetworkAds>NONE</NetworkAds>
		<ExternalAds>NONE</ExternalAds>
	</Publishing>
	
	<Debug>
		<ShowStats>false</ShowStats>
	</Debug>
	
	<Support>
		<DevName>Origaming Media</DevName>
		<DevWebsite>http://origamingmedia.com</DevWebsite>
		<DevSupport>feedback@origamingmedia.com</DevSupport>
	</Support>
	
