%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogue_ko
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: ko
  m_SharedData: {fileID: 11400000, guid: 2cc0bd982a631b0419e7c882434b18de, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 3882393526272
    m_Localized: "\uB4DC\uB514\uC5B4 \uC694\uB9AC \uD559\uAD50 \uC0DD\uD65C\uC774
      \uB05D\uB0AC\uC5B4!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109184
    m_Localized: "\uC774\uC81C \uD558\uB8E8 \uC885\uC77C \uC790\uACA9\uC99D \uC788\uB294
      \uC170\uD504\uB85C\uC11C \uC77C\uC5D0 \uC9D1\uC911\uD560 \uC218 \uC788\uC5B4!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109185
    m_Localized: "\uC694\uB9AC \uD559\uAD50 \uCCAB\uB0A0\uBD80\uD130 \uAC00\uAC8C\uB97C
      \uC5F4 \uC0DD\uAC01\uC744 \uD588\uC5B4. \uB4DC\uB514\uC5B4 \uADF8\uB54C\uAC00
      \uC640\uC11C \uB108\uBB34 \uC124\uB808!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109186
    m_Localized: "\uD568\uAED8\uD574 \uC904 \uC0AC\uB78C\uC774 \uD544\uC694\uD574.
      \uB098\uB97C \uB3C4\uC640\uC904\uB798?"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109187
    m_Localized: "\uBB3C\uB860\uC774\uC9C0!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109188
    m_Localized: "\uBC14\uB85C \uADF8\uAC70\uC57C! \uC790, \uCCAB\uB0A0\uC744 \uC2DC\uC791\uD574
      \uBCF4\uC790!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109189
    m_Localized: "\uB0B4 \uC8FC\uBC29\uC5D0 \uC628 \uAC78 \uD658\uC601\uD574! \uB0B4\uAC00
      \uC548\uB0B4\uD574 \uC904\uAC8C!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109190
    m_Localized: "\uC88B\uC544!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109191
    m_Localized: "\uBAA9\uD45C\uB294 \uB9DB\uC788\uB294 \uC694\uB9AC\uB97C \uB9CC\uB4E4\uC5B4
      \uB3C8\uC744 \uCDA9\uBD84\uD788 \uBC84\uB294 \uAC70\uC57C. \uC5EC\uAE30 \uBCF4\uC774\uB294
      \uAC8C \uC624\uB298 \uB300\uC811\uD574\uC57C \uD560 \uC190\uB2D8 \uC218\uC57C."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109192
    m_Localized: "\uC190\uB2D8\uC774 \uC654\uC5B4! \uC5EC\uAE30 \uC694\uB9AC\uB97C
      \uC644\uC131\uD558\uB294 \uB370 \uD544\uC694\uD55C \uC7AC\uB8CC \uBAA9\uB85D\uC774
      \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109193
    m_Localized: "\uC7AC\uB8CC\uB97C \uBC14\uAFD4\uC11C \uAC19\uC740 \uC7AC\uB8CC\uB97C
      3\uAC1C \uC774\uC0C1 \uB9DE\uCDB0 \uBD10."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109194
    m_Localized: "\uC88B\uC544! \uACC4\uC18D \uC7AC\uB8CC\uB97C \uB9DE\uCDB0\uC11C
      \uC694\uB9AC\uB97C \uC644\uC131\uD558\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109195
    m_Localized: "\uCD95\uD558\uD574! \uCCAB \uC694\uB9AC\uB97C \uC644\uC131\uD588\uC5B4!
      \uC774\uC81C \uB3C8\uC744 \uD074\uB9AD\uD574\uC11C \uBC1B\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109196
    m_Localized: "\uC190\uB2D8\uB9C8\uB2E4 \uC778\uB0B4\uC2EC \uAC8C\uC774\uC9C0\uB97C
      \uC798 \uC0B4\uD3B4\uBD10. \uAE30\uBD84\uC774 \uC88B\uC744\uC218\uB85D \uD301\uC744
      \uB354 \uB9CE\uC774 \uC904 \uAC70\uC57C!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109197
    m_Localized: "\uC54C\uACA0\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109198
    m_Localized: "\uD558\uB098 \uB354 \uC54C\uB824 \uC904\uAC8C: \uC190\uB2D8\uC774
      2\uBA85 \uC774\uC0C1\uC77C \uB54C \uC811\uC2DC\uB97C \uD074\uB9AD\uD558\uBA74
      \uC6B0\uC120\uC21C\uC704\uB97C \uBC14\uAFC0 \uC218 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109199
    m_Localized: "\uC900\uBE44\uB294 \uB2E4 \uB41C \uAC83 \uAC19\uC544! \uC190\uB2D8\uB4E4\uC744
      \uACC4\uC18D \uB9DE\uC774\uD558\uACE0 \uC798 \uB300\uC811\uD558\uC790!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109200
    m_Localized: "\uBB38\uC81C\uC5C6\uC5B4!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109201
    m_Localized: "\uC798\uD588\uC5B4, (player)! \uC5B4\uC81C \uC815\uB9D0 \uB300\uB2E8\uD588\uC5B4!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109202
    m_Localized: "\uBE68\uB9AC \uC694\uB9AC\uD558\uACE0 \uC2F6\uC5B4 \uBABB \uCC38\uACA0\uC5B4!
      \uC9C0\uAE08 \uBC14\uB85C \uC2DC\uC791\uD558\uC790!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109203
    m_Localized: "\uC88B\uC740 \uC18C\uC2DD\uC774\uC57C! '\uD648 \uBA54\uC774\uD06C\uC624\uBC84'
      \uAC8C\uC784\uC5D0 \uB098\uC624\uB294 \uC720\uBA85\uD55C \uC5E0\uB9C8 \uC54C\uC9C0?
      \uC11C\uC810\uC744 \uC5F4\uB824\uACE0 \uB9C8\uC744\uC5D0 \uC654\uB300!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109204
    m_Localized: "\uBA4B\uC9C0\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109205
    m_Localized: "\uC774\uC81C \uC0C8 \uB808\uC2DC\uD53C\uB97C \uC0AC\uACE0 \uAE30\uC874
      \uB808\uC2DC\uD53C\uB97C \uC5C5\uADF8\uB808\uC774\uB4DC\uD560 \uC218 \uC788\uC5B4!
      \uC5EC\uAE30\uB97C \uD074\uB9AD\uD574\uC11C \uB808\uC2DC\uD53C \uCC45\uC744
      \uC5F4\uC5B4 \uBD10!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109206
    m_Localized: "\uB514\uB7ED\uC2A4 \uCE58\uD0A8 \uD06C\uB8E8\uC544\uC0C1 \uB808\uC2DC\uD53C\uB97C
      \uC0AC \uBCF4\uB294 \uAC8C \uC5B4\uB54C?"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109207
    m_Localized: "\uC5EC\uAE30\uB97C \uD074\uB9AD\uD558\uBA74 \uBAA9\uB85D\uC758
      \uB2E4\uC74C \uB808\uC2DC\uD53C\uB97C \uBCFC \uC218 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109208
    m_Localized: "\uC774 \uBC84\uD2BC\uC744 \uD074\uB9AD\uD574\uC11C \uC0AC\uC790!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109209
    m_Localized: "\uBA4B\uC838! \uC0C8 \uB808\uC2DC\uD53C\uB97C \uC0C0\uC5B4! \uB354
      \uC88B\uC740 \uB808\uC2DC\uD53C\uB97C \uACC4\uC18D \uC0AC\uC11C \uB808\uC2A4\uD1A0\uB791\uC758
      \uBA85\uC131\uC744 \uB192\uC774\uC790!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109210
    m_Localized: "\uC88B\uC544!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109211
    m_Localized: "\uADF8\uB9AC\uACE0 \uB808\uC2DC\uD53C\uB97C \uC5C5\uADF8\uB808\uC774\uB4DC\uD558\uBA74
      \uC694\uB9AC\uC758 \uAC00\uCE58\uAC00 \uC62C\uB77C\uAC00. \uBE44\uC300\uC218\uB85D
      \uC6B0\uB9AC\uAC00 \uB354 \uB9CE\uC774 \uBC8C \uC218 \uC788\uC5B4!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109212
    m_Localized: "\uB3C8\uC774 \uCDA9\uBD84\uD558\uBA74 \uC5B8\uC81C\uB4E0 \uC0C1\uC810\uC5D0
      \uB4E4\uB974\uB294 \uAC70 \uC78A\uC9C0 \uB9C8!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109213
    m_Localized: "\uC774 \uC5C4\uCCAD\uB09C \uB09C\uC7A5\uD310 \uC880 \uBD10! \uC6B0\uB9AC\uAC00
      \uBC14\uB85C \uC774 \uC8FC\uBC29\uC5D0\uC11C \uB9DB\uC788\uB294 \uC694\uB9AC\uB97C
      \uB9CC\uB4E4\uC5C8\uB2E4\uACE0 \uB204\uAC00 \uBBFF\uACA0\uC5B4?"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109214
    m_Localized: "\uC544\uBB34\uB3C4 \uC548 \uBBFF\uC744\uAC78"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109215
    m_Localized: "\uC8FC\uBC29\uC740 \uD56D\uC0C1 \uAE68\uB057\uD558\uAC8C \uC815\uB9AC\uD574\uC57C
      \uD55C\uB2E4\uB294 \uB9D0 \uC54C\uC9C0? \uC815\uB9D0 \uB9DE\uB294 \uB9D0\uC774\uC57C.
      \uC774\uB807\uAC8C \uC5B4\uC9C8\uB7EC\uC838 \uC788\uC73C\uBA74 \uC694\uB9AC\uB97C
      \uD560 \uC218 \uC5C6\uAC70\uB4E0."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109216
    m_Localized: "\uB108\uB3C4 \uB098\uB9CC\uD07C \uC694\uB9AC\uB97C \uC88B\uC544\uD558\uB294
      \uAC70 \uC54C\uC9C0\uB9CC, \uBA3C\uC800 \uC5EC\uAE30\uB97C \uCE58\uC6CC\uC57C
      \uD574! \uBE68\uB9AC \uB05D\uB0BC\uC218\uB85D \uC88B\uC544. \uC2DC\uC791\uD558\uC790!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109217
    m_Localized: "\uC8FC\uBC29\uC5D0\uC11C \uBB3C\uAC74 \uB300\uBD80\uBD84\uC744
      \uCE58\uC6CC\uC57C \uD574. \uBB3C\uAC74 \uBAA9\uB85D\uC744 \uC900\uBE44\uD574
      \uB480\uC73C\uB2C8 \uC26C\uC6B8 \uAC70\uC57C!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109218
    m_Localized: "\uC800\uAE30 \uC788\uB2E4, \uBAA9\uB85D \uB9E8 \uC704\uC758 \uBB3C\uAC74\uC774\uC57C.
      \uD074\uB9AD\uD574\uC11C \uC9D1\uC5B4 \uBD10."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109219
    m_Localized: "\uC88B\uC544! \uC774\uC81C \uB450 \uBC88\uC9F8 \uBB3C\uAC74\uC740
      \uD78C\uD2B8\uB97C \uC368 \uBCF4\uC790. \uC5EC\uAE30\uB97C \uD074\uB9AD\uD574\uC11C
      \uD78C\uD2B8\uB97C \uC0AC\uC6A9\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109220
    m_Localized: "\uD78C\uD2B8\uB294 \uCC9C\uCC9C\uD788 \uB2E4\uC2DC \uCC28\uC624\uB974\uB2C8\uAE4C
      \uACC4\uC18D \uC4F8 \uC218 \uC788\uC5B4. \uC815\uB9D0 \uCE5C\uC808\uD558\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109221
    m_Localized: "\uC751!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109222
    m_Localized: "\uB9C8\uC9C0\uB9C9 \uD301: CTRL \uD0A4\uB97C \uB204\uB978 \uCC44\uB85C
      \uB9C8\uC6B0\uC2A4\uB97C \uB4DC\uB798\uADF8\uD558\uBA74 \uD655\uB300\uD558\uACE0
      \uCD95\uC18C\uD560 \uC218 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109223
    m_Localized: "\uC774\uC81C \uB0A8\uC740 \uBB3C\uAC74\uC740 \uC9C1\uC811 \uCC3E\uC544\uBD10.
      \uD589\uC6B4\uC744 \uBE4C\uC5B4!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109224
    m_Localized: "\uC190\uB2D8\uB9C8\uB2E4 \uC131\uACA9\uC774 \uB2E4 \uB2EC\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109225
    m_Localized: "\uC778\uB0B4\uC2EC\uC740 \uB9CE\uC9C0\uB9CC \uD301\uC744 \uC801\uAC8C
      \uC8FC\uB294 \uC190\uB2D8\uB3C4 \uC788\uACE0, \uC904 \uC11C\uBA74 \uAE08\uBC29
      \uC9DC\uC99D \uB0B4\uC9C0\uB9CC \uD301\uC744 \uB9CE\uC774 \uC8FC\uB294 \uC190\uB2D8\uB3C4
      \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109226
    m_Localized: "\uC6B0\uC120\uC21C\uC704\uB97C \uC798 \uC815\uD574\uC11C \uD558\uB8E8
      \uC218\uC775\uC744 \uCD5C\uB300\uB85C \uC62C\uB9AC\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109227
    m_Localized: "(player), \uC624\uB298 \uC74C\uC2DD \uD3C9\uB860\uAC00\uAC00 \uC628\uB300!
      \uC5B4\uB5A1\uD574!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109228
    m_Localized: "\uC74C\uC2DD \uD3C9\uB860\uAC00\uB294 \uCD5C\uC545\uC758 \uC190\uB2D8\uC774\uB798!
      \uBCF4\uD1B5 \uAC00\uAC8C\uC5D0\uC11C \uC81C\uC77C \uC88B\uC740 \uC694\uB9AC\uB97C
      \uC2DC\uD0A4\uACE0 \uBE68\uB9AC \uB0B4\uC624\uB77C\uACE0 \uD55C\uB300!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109229
    m_Localized: "\uC624\uB298\uC740 \uBAA8\uB4E0 \uAC8C \uC798 \uB418\uB3C4\uB85D
      \uD574\uC57C \uD574! \uCD5C\uC120\uC744 \uB2E4\uD558\uC790!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109230
    m_Localized: "\uC800\uAE30 \uC654\uB2E4! \uADF8 \uC545\uBA85 \uB192\uC740, \uC2DC\uD070\uB465\uD55C
      \uC5BC\uAD74\uC758 \uC74C\uC2DD \uD3C9\uB860\uAC00\uC57C!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109231
    m_Localized: "\uC6B0\uB9AC \uAC00\uAC8C\uC5D0\uC11C \uC81C\uC77C \uBE44\uC2FC
      \uC694\uB9AC\uB97C \uBAA8\uB4E0 \uD1A0\uD551 \uCD94\uAC00\uB85C \uC8FC\uBB38\uD588\uC5B4!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109232
    m_Localized: "\uC88B\uC740 \uD3C9\uAC00\uB97C \uAF2D \uBC1B\uC544\uC57C \uD558\uB2C8\uAE4C
      \uC6D0\uD558\uB294 \uAC74 \uB2E4 \uC5F4\uC2EC\uD788 \uD574 \uC8FC\uC790!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109233
    m_Localized: "\uADF8\uB9AC\uACE0 \uAE30\uC5B5\uD574: \uC74C\uC2DD \uD3C9\uB860\uAC00\uC758
      \uC811\uC2DC\uB97C \uD074\uB9AD\uD558\uBA74 \uADF8 \uC8FC\uBB38\uC744 \uCD5C\uC6B0\uC120\uC73C\uB85C
      \uD560 \uC218 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109234
    m_Localized: "\uC624\uB298 \uC815\uB9D0 \uC798\uD588\uC5B4! \uB108\uBB34 \uAE30\uBED0!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109235
    m_Localized: "\uC88B\uC740 \uC18C\uC2DD \uB354 \uB4E3\uACE0 \uC2F6\uC5B4? \uAE00\uC384,
      \uC911\uAD6D \uC694\uB9AC \uC61B\uB0A0 \uB808\uC2DC\uD53C\uB97C \uCC3E\uC558\uC5B4!
      \uB300\uB2E8\uD558\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109236
    m_Localized: "\uBE68\uB9AC \uD574 \uBCF4\uACE0 \uC2F6\uC5B4\uC11C \uBABB \uCC38\uACA0\uC9C0?
      \uC900\uBE44\uB418\uBA74 \uC8FC\uBC29\uC73C\uB85C \uAC00\uC790!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109237
    m_Localized: "\uCD95\uD558\uD574, \uC774\uC81C \uBA4B\uC9C4 \uC911\uAD6D \uC694\uB9AC\uB4E4\uC744
      \uB9CC\uB4E4 \uC218 \uC788\uC5B4!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109238
    m_Localized: "\uC0C1\uC810\uC5D0\uC11C \uC5B8\uC81C\uB4E0 \uC0C8 \uB808\uC2DC\uD53C\uB97C
      \uC0AC\uACE0 \uC7AC\uB8CC\uB97C \uC5C5\uADF8\uB808\uC774\uB4DC\uD560 \uC218
      \uC788\uB2E4\uB294 \uAC78 \uAE30\uC5B5\uD574!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109239
    m_Localized: "\uC788\uC796\uC544, \uC720\uAE30\uB18D \uB9C8\uCF13\uC744 \uC5F0
      \uAC8C \uB204\uAD70\uC9C0 \uC54C\uC544? \uB610 \uC5E0\uB9C8\uC57C!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109240
    m_Localized: "\uC815\uB9D0?"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109241
    m_Localized: "\uC774\uC81C \uC7AC\uB8CC\uB97C \uC5C5\uADF8\uB808\uC774\uB4DC\uD574\uC11C
      \uC694\uB9AC\uB97C \uB354 \uB9DB\uC788\uAC8C \uB9CC\uB4E4 \uC218 \uC788\uC5B4!
      \uBA54\uB274 \uAC00\uACA9\uB3C4 \uC62C\uB9B4 \uC218 \uC788\uB2E4\uB294 \uB73B\uC774\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109242
    m_Localized: "\uC5E0\uB9C8\uB124 \uAC00\uAC8C\uC5D0 \uAC00 \uBCF4\uC790!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109243
    m_Localized: "\uC640, \uC774 \uC2E0\uC120\uD55C \uCC44\uC18C\uB4E4 \uC880 \uBD10!
      \uC694\uB9AC\uC0AC\uC5D0\uAC8C\uB294 \uCC9C\uAD6D\uC774\uC57C!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109244
    m_Localized: "\uC5EC\uAE30\uB97C \uAD6C\uACBD\uC2DC\uCF1C \uC904\uAC8C..."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109245
    m_Localized: "\uC5EC\uAE30\uC5D0 \uC9C4\uC5F4\uB41C \uC7AC\uB8CC \uC774\uB984\uC774
      \uB098\uC640."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109246
    m_Localized: "\uC544\uB798\uC5D0\uC11C \uC7AC\uB8CC \uB808\uBCA8, \uC5C5\uADF8\uB808\uC774\uB4DC
      \uAC00\uACA9, \uAD6C\uB9E4 \uD6A8\uACFC \uAC19\uC740 \uC815\uBCF4\uB97C \uB354
      \uBCFC \uC218 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109247
    m_Localized: "\uC7AC\uB8CC\uB294 10\uB808\uBCA8\uAE4C\uC9C0 \uC5C5\uADF8\uB808\uC774\uB4DC\uD560
      \uC218 \uC788\uC5B4. \uAC00\uC7A5 \uB9CE\uC774 \uC4F0\uB294 \uC7AC\uB8CC\uBD80\uD130
      \uC5C5\uADF8\uB808\uC774\uB4DC\uD558\uB294 \uAC78 \uCD94\uCC9C\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109248
    m_Localized: "\uC774\uC81C \uC774 \uC7AC\uB8CC\uB97C \uC5C5\uADF8\uB808\uC774\uB4DC\uD574
      \uBCF4\uC790. \uC5C5\uADF8\uB808\uC774\uB4DC \uBC84\uD2BC\uC744 \uD074\uB9AD\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109249
    m_Localized: "\uBA4B\uC838! \uC774\uC81C \uC694\uB9AC\uC5D0 \uC4F8 \uB354 \uC88B\uC740
      \uC7AC\uB8CC\uB97C \uC5BB\uB294 \uBC29\uBC95\uC744 \uC54C\uAC8C \uB410\uC5B4!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109250
    m_Localized: "\uB9C8\uC9C0\uB9C9 \uD301: \uC790\uC8FC \uC640\uC11C \uC5C5\uADF8\uB808\uC774\uB4DC\uD574\uC11C
      \uC190\uB2D8\uB4E4\uC5D0\uAC8C \uD56D\uC0C1 \uCD5C\uACE0\uC758 \uD488\uC9C8\uC744
      \uB300\uC811\uD558\uC790!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109251
    m_Localized: "\uC54C\uACE0 \uC788\uC5C8\uC5B4? \uB098 \uD504\uB85C\uC98C \uC694\uAC70\uD2B8\uB3C4
      \uC815\uB9D0 \uC798 \uB9CC\uB4E4\uC5B4! \uBC29\uAE08 \uC794\uB729 \uB9CC\uB4E4\uC5C8\uC5B4!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109252
    m_Localized: "\uC624\uB298\uC740 \uB0B4 \uD2B9\uC81C \uD504\uB85C\uC98C \uC694\uAC70\uD2B8\uB97C
      \uD314\uC544\uC11C \uBAA8\uB450\uAC00 \uC990\uAE30\uAC8C \uD558\uACE0 \uC2F6\uC5B4!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109253
    m_Localized: "\uADF8\uB7EC\uB2C8\uAE4C \uC624\uB298 \uC7A5\uC0AC\uB294 \uC624\uC9C1
      \uD504\uB85C\uC98C \uC694\uAC70\uD2B8\uBFD0\uC774\uC57C!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109254
    m_Localized: "\uC774\uB9AC \uC640, \uB0B4\uAC00 \uD558\uB098\uC529 \uC54C\uB824
      \uC904\uAC8C!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109255
    m_Localized: "\uCEF5\uBD80\uD130 \uC694\uAC70\uD2B8\uAE4C\uC9C0 \uB2E4 \uC900\uBE44\uD574
      \uB480\uC73C\uB2C8 \uBC14\uB85C \uC2DC\uC791\uD560 \uC218 \uC788\uC5B4!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109256
    m_Localized: "\uC190\uB2D8\uC774 \uC654\uC5B4! \uB531 \uC88B\uC740 \uD0C0\uC774\uBC0D\uC774\uC57C!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109257
    m_Localized: "\uC5EC\uAE30\uC11C \uC190\uB2D8\uC774 \uC6D0\uD558\uB294 \uD504\uB85C\uC98C
      \uC694\uAC70\uD2B8\uB97C \uBCFC \uC218 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109258
    m_Localized: "\uB9CC\uB4DC\uB294 \uAC74 \uC544\uC8FC \uC26C\uC6CC. \uBA3C\uC800
      \uCEF5\uC744 \uACE8\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109259
    m_Localized: "\uADF8\uB2E4\uC74C \uC190\uB2D8\uC774 \uC6D0\uD558\uB294 \uC694\uAC70\uD2B8\uB97C
      \uACE8\uB77C."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109260
    m_Localized: "\uC11D\uB958 \uC2DC\uB7FD\uC744 \uACC1\uB4E4\uC774\uACE0 \uC2F6\uB300."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109261
    m_Localized: "\uD0A4\uC704\uB97C \uC62C\uB824."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109262
    m_Localized: "\uB9C8\uC9C0\uB9C9\uC73C\uB85C \uC74C\uB8CC 1\uC794!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109263
    m_Localized: "\uD574\uB0C8\uC5B4! \uCCAB \uC694\uAC70\uD2B8\uB97C \uD314\uC558\uC5B4!
      \uBCC4\uB85C \uC5B4\uB835\uC9C0 \uC54A\uC558\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109264
    m_Localized: "\uC704\uC5D0\uC11C \uC544\uB798\uB85C, \uC67C\uCABD\uC5D0\uC11C
      \uC624\uB978\uCABD\uC73C\uB85C \uB9CC\uB4E4\uC5B4\uC57C \uD55C\uB2E4\uB294
      \uAC83\uB9CC \uAE30\uC5B5\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109265
    m_Localized: "\uADF8\uB9AC\uACE0 \uC190\uB2D8\uC758 \uC778\uB0B4\uC2EC \uAC8C\uC774\uC9C0\uB97C
      \uAF2D \uC9C0\uCF1C\uBD10. \uB108\uBB34 \uC624\uB798 \uAE30\uB2E4\uB9AC\uBA74
      \uAC00 \uBC84\uB824!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109266
    m_Localized: "\uAD6C\uC11D\uC5D0 \uC788\uB294 \uC800 \uADC0\uC5EC\uC6B4 \uAC70
      \uBCF4\uC5EC? \uC6B0\uB9AC\uC758 \uC0C8 \uC74C\uB8CC \uAE30\uACC4\uC57C! \uC5B4\uB5BB\uAC8C
      \uC4F0\uB294\uC9C0 \uBCF4\uC5EC \uC904\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109267
    m_Localized: "\uC9C0\uAE08 \uAE30\uACC4\uB294 (juice percentage) \uC644\uC131\uB410\uC5B4.
      \uC6B0\uB9AC\uAC00 \uC694\uB9AC\uD558\uB294 \uB3D9\uC548 \uC791\uB3D9\uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109268
    m_Localized: "\uC774\uAC78 \uB9DE\uCDB0 \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109269
    m_Localized: "\uC88B\uC544, \uC74C\uB8CC\uAC00 \uC900\uBE44\uB410\uC5B4!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109270
    m_Localized: "\uAE30\uACC4\uB97C \uD074\uB9AD\uD574\uC11C \uC190\uB2D8\uC5D0\uAC8C
      \uB4DC\uB798\uADF8\uD558\uBA74 \uC74C\uB8CC\uB97C \uC904 \uC218 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109271
    m_Localized: "\uC74C\uB8CC\uB97C \uC8FC\uBA74 \uC190\uB2D8 \uB9CC\uC871\uB3C4\uAC00
      \uC62C\uB77C\uAC00\uC11C \uC6B0\uB9AC \uC218\uC785\uB3C4 \uB298\uC5B4\uB098!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109272
    m_Localized: "\uAC00\uB2A5\uD558\uBA74 \uB3C8\uC744 \uBC14\uB85C \uBC1B\uC9C0
      \uB9D0\uACE0 \uAE30\uB2E4\uB824 \uBD10."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109273
    m_Localized: "\uC190\uB2D8 3\uBA85\uC5D0\uAC8C\uC11C \uD55C\uAEBC\uBC88\uC5D0
      \uB3C8\uC744 \uBC1B\uC73C\uBA74 \uC5F0\uC1C4 \uBCF4\uB108\uC2A4\uB97C \uBC1B\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109274
    m_Localized: "\uC544\uC8FC \uC801\uC740 \uAE08\uC561\uC774\uB77C\uB3C4 \uC804\uBB38\uAC00
      \uC810\uC218\uC5D0 \uB3C4\uB2EC\uD558\uB294 \uB370 \uD070 \uB3C4\uC6C0\uC774
      \uB3FC."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109275
    m_Localized: "\uADF8 \uC74C\uC2DD \uD3C9\uB860\uAC00\uAC00 \uB610 \uC6B0\uB9AC\uB97C
      \uC0B4\uD53C\uB7EC \uC654\uC5B4! \uC6B0\uB9AC \uC2E4\uB825\uC744 \uBCF4\uC5EC
      \uC8FC\uC790!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109276
    m_Localized: "\uC7AC\uB8CC\uB97C 4\uAC1C \uB118\uAC8C \uB9DE\uCD94\uBA74 \uBC14\uB85C
      \uBCF4\uB108\uC2A4 \uB3C8\uC744 \uBC1B\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109277
    m_Localized: "\uAE30\uBCF8\uC801\uC73C\uB85C\uB294 \uAC00\uC7A5 \uAE34 \uC904\uC744
      \uCD5C\uB300\uD55C \uBE68\uB9AC \uCC3E\uB3C4\uB85D \uD574."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109278
    m_Localized: "\uBE68\uB9AC \uB9DE\uCD9C\uC218\uB85D \uC694\uB9AC \uC2DC\uAC04\uC774
      \uC9E7\uC544\uC838\uC11C \uACB0\uAD6D \uD301\uC744 \uB354 \uB9CE\uC774 \uBC8C
      \uC218 \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109279
    m_Localized: "(player), \uCE74\uC6B4\uD130\uC5D0 \uC0C8 \uAC10\uC790\uD280\uAE40
      \uAE30\uACC4\uB97C \uC124\uCE58\uD588\uC5B4. \uC774\uC81C \uB9DB\uC788\uB294
      \uAC10\uC790\uD280\uAE40\uC744 \uD314 \uC218 \uC788\uC5B4!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109280
    m_Localized: "\uC74C\uB8CC \uAE30\uACC4\uC640 \uB611\uAC19\uC774 \uC791\uB3D9\uD558\uC9C0\uB9CC,
      \uD639\uC2DC \uC78A\uC5C8\uC744\uAE4C \uBD10 \uB2E4\uC2DC \uC124\uBA85\uD560\uAC8C."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109281
    m_Localized: "\uC774\uAC78 \uB9DE\uCDB0\uC11C \uAC10\uC790\uD280\uAE40\uC744
      \uC644\uC131\uD558\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109282
    m_Localized: "\uAC10\uC790\uD280\uAE40\uC774 \uC900\uBE44\uB410\uC5B4!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109283
    m_Localized: "\uAE30\uACC4\uB97C \uD074\uB9AD\uD574\uC11C \uC190\uB2D8\uC5D0\uAC8C
      \uB4DC\uB798\uADF8\uD558\uBA74 \uAC10\uC790\uD280\uAE40\uC744 \uC904 \uC218
      \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109284
    m_Localized: "\uC0AC\uC774\uB4DC \uBA54\uB274\uB098 \uC74C\uB8CC\uB97C \uC8FC\uBA74
      \uC190\uB2D8 \uB9CC\uC871\uB3C4\uAC00 \uC62C\uB77C\uAC00\uC11C \uD301\uB3C4
      \uB9CE\uC544\uC838!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109285
    m_Localized: "\uB610 \uC8FC\uBC29\uC744 \uCCAD\uC18C\uD560 \uC2DC\uAC04\uC774\uC57C!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109286
    m_Localized: "\uBA70\uCE60 \uB9CC\uC5D0 \uC774\uB807\uAC8C \uC5B4\uC9C8\uB800\uB2E4\uB2C8
      \uC544\uC9C1\uB3C4 \uBBFF\uAE30\uC9C0 \uC54A\uC544! \uC5F4\uC2EC\uD788 \uD574\uC11C
      \uC5EC\uAE30\uB97C \uBC18\uC9DD\uBC18\uC9DD\uD558\uAC8C \uB9CC\uB4E4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109287
    m_Localized: "\uB3C4\uC804\uC801\uC778 \uC5C5\uC801\uC774 10\uAC1C \uC788\uC5B4.
      \uBAA8\uB450 \uB2EC\uC131\uD558\uB3C4\uB85D \uB178\uB825\uD574 \uBD10."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109288
    m_Localized: "\uC774\uB7F0, \uC74C\uC2DD \uD3C9\uB860\uAC00\uAC00 \uB610 \uC654\uC5B4.
      \uC6B0\uB9AC \uC2E4\uB825\uC744 \uBCF4\uC5EC \uC8FC\uC790!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109289
    m_Localized: "\uCD95\uD558\uD574, \uC774\uC81C \uB9E4\uCF64\uD558\uACE0 \uC774\uAD6D\uC801\uC778
      \uC911\uB3D9 \uC694\uB9AC\uB4E4\uC744 \uB9CC\uB4E4 \uC218 \uC788\uC5B4!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109290
    m_Localized: "\uB610 \uD2B9\uC81C \uD504\uB85C\uC98C \uC694\uAC70\uD2B8\uB97C
      \uD314 \uC2DC\uAC04\uC774\uC57C! \uC190\uB2D8\uB9C8\uB2E4 \uC62C\uBC14\uB978
      \uC870\uD569\uC744 \uCD5C\uB300\uD55C \uBE68\uB9AC \uB9CC\uB4E4\uC5B4\uC11C
      \uB3C8\uC744 \uB354 \uB9CE\uC774 \uBC8C\uC790!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109291
    m_Localized: "\uC774\uB7F0, \uC5B4\uC82F\uBC24\uC5D0 \uB0C9\uC7A5\uACE0\uAC00
      \uACE0\uC7A5 \uB098\uC11C \uC2E0\uC120\uD55C \uC7AC\uB8CC\uAC00 \uC5BC\uC5B4
      \uBC84\uB838\uC5B4!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109292
    m_Localized: "\uAD1C\uCC2E\uC544, \uC6B0\uB9AC\uAC00 \uD574\uACB0\uD560 \uC218
      \uC788\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109293
    m_Localized: "\uC5BC\uC5B4\uBD99\uC740 \uCE78\uC740 \uB179\uC774\uB294 \uB370
      \uD55C \uB2E8\uACC4\uAC00 \uB354 \uD544\uC694\uD574. \uC0AC\uC2E4 \uC544\uC8FC
      \uC26C\uC6CC. \uC774\uAC78 \uBC14\uAFD4 \uBD10."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109294
    m_Localized: "\uC774\uC81C \uADF8 \uC7AC\uB8CC\uAC00 \uC6D0\uB798\uB300\uB85C
      \uB3CC\uC544\uC654\uC5B4. \uBB38\uC81C \uD574\uACB0!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109295
    m_Localized: "\uC694\uB9AC\uB97C \uB354 \uBE68\uB9AC \uD558\uACE0 \uC7AC\uB8CC\uB3C4
      \uB354 \uC27D\uAC8C \uB179\uC77C \uC218 \uC788\uB294 \uC544\uC8FC \uC720\uC6A9\uD55C
      \uB3C4\uAD6C\uB97C \uC0C0\uC5B4!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109296
    m_Localized: "\uC774\uAC8C \uC170\uD504\uC758 \uD1A0\uCE58\uC57C! \uC4F0\uB824\uBA74
      \uC6D0\uD558\uB294 \uBC29\uD5A5\uC73C\uB85C \uBC14\uAFB8\uAE30\uB9CC \uD558\uBA74
      \uB3FC. \uC9C0\uAE08\uC740 \uC704\uB85C \uBC14\uAFD4 \uBCF4\uC790."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109297
    m_Localized: "\uC815\uB9D0 \uD3B8\uB9AC\uD558\uC9C0?"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109298
    m_Localized: "\uC170\uD504\uC758 \uD1A0\uCE58\uB294 \uC694\uB9AC\uD310\uC5D0
      \uAC00\uB054 \uB098\uD0C0\uB098\uB2C8\uAE4C \uC798 \uC9C0\uCF1C\uBD10!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109299
    m_Localized: "\uC2DC\uD070\uB465\uD55C \uC5BC\uAD74\uC774 \uBCF4\uC5EC. \uBD84\uBA85
      \uADF8 \uC74C\uC2DD \uD3C9\uB860\uAC00\uC77C \uAC70\uC57C. \uC6C3\uAC8C \uB9CC\uB4E4
      \uC218 \uC788\uC744\uC9C0 \uBCF4\uC790!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109300
    m_Localized: "\uC190\uB2D8\uC744 \uD55C\uB3D9\uC548 \uAE30\uBD84 \uC88B\uAC8C
      \uD574 \uC904 \uC88B\uC740 \uAC8C \uC788\uC5B4: \uACF5\uC9DC \uCFE0\uD0A4!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109301
    m_Localized: "\uC7AC\uB8CC\uB97C 5\uAC1C \uC774\uC0C1 \uB9DE\uCD9C \uB54C\uB9C8\uB2E4
      \uCFE0\uD0A4\uAC00 \uB098\uD0C0\uB098. \uD074\uB9AD\uD558\uBA74 \uC190\uB2D8\uC758
      \uC778\uB0B4\uC2EC\uC774 \uC62C\uB77C\uAC00."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109302
    m_Localized: "\uC778\uB0B4\uC2EC\uC774 \uAC00\uC7A5 \uC801\uAC8C \uB0A8\uC740
      \uC190\uB2D8\uC774 \uB108\uC758 \uC120\uBB3C\uC744 \uBC1B\uACE0 \uC870\uAE08
      \uB354 \uAE30\uBD84\uC774 \uC88B\uC544\uC9C8 \uAC70\uC57C!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109303
    m_Localized: "\uB9C8\uC9C0\uB9C9\uC73C\uB85C, \uC0C1\uC810\uC5D0\uC11C \uADF8
      \uD6A8\uACFC\uB97C \uC5C5\uADF8\uB808\uC774\uB4DC\uD560 \uC218 \uC788\uC5B4.
      \uD589\uC6B4\uC744 \uBE4C\uC5B4!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109304
    m_Localized: "\uB610 \uC8FC\uBC29\uC744 \uCCAD\uC18C\uD560 \uC2DC\uAC04\uC774\uC57C!
      \uC18C\uB9E4\uB97C \uAC77\uACE0 \uACE0\uBB34\uC7A5\uAC11\uC744 \uB07C\uACE0
      \uC2DC\uC791\uD558\uC790!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109305
    m_Localized: "\uC788\uC796\uC544, \uC6B0\uB9AC \uB3C4\uAD6C\uB97C \uC880 \uC5C5\uADF8\uB808\uC774\uB4DC\uD574\uC57C
      \uD560 \uAC83 \uAC19\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109306
    m_Localized: "\uCC2C\uC131"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109307
    m_Localized: "\uADFC\uCC98 \uAC00\uAC8C\uC5D0 \uAC00\uC11C \uBB50\uAC00 \uC788\uB294\uC9C0
      \uBCF4\uC790!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109308
    m_Localized: "\uC544, \uC800 \uBC18\uC9DD\uC774\uB294 \uAC10\uC790\uD280\uAE40
      \uAE30\uACC4 \uC880 \uBD10! \uC6B0\uB9AC \uB808\uC2A4\uD1A0\uB791 \uC11C\uBE44\uC2A4\uB97C
      \uB354 \uC88B\uAC8C \uB9CC\uB4E4 \uCD5C\uACE0\uC758 \uD22C\uC790 \uAC19\uC9C0
      \uC54A\uC544?"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109309
    m_Localized: "\uD558\uC9C0\uB9CC \uACB0\uC815\uC740 \uB108\uC5D0\uAC8C \uB9E1\uAE38\uAC8C.
      \uC5C5\uADF8\uB808\uC774\uB4DC\uD558\uACE0 \uC2F6\uB2E4\uBA74 \uC5B4\uB514\uB85C
      \uAC00\uC57C \uD560\uC9C0 \uC54C\uC9C0?"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
