  m_Script: {fileID: 11500000, guid: 5b11a58205ec3474ca216360e9fa74a8, type: 3}
  m_Name: Events Shared Data
  m_EditorClassIdentifier: 
  m_TableCollectionName: Events
  m_TableCollectionNameGuidString: c451a22b809da524bab65eb1e1fc7a66
  m_Entries:
  - m_Id: 3882234142720
    m_Key: "This cutie pie waits patiently in line and doesn\u2019t ask much. The
      best kind of customer!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882246725632
    m_Key: Nothing beats seeing a cheerful, smiling boy queuing patiently at our
      restaurant!
    m_Metadata:
      m_Items: []
  - m_Id: 3882246725633
    m_Key: Business men have hectic schedules, so you can expect them to pay more
      for fast service.
    m_Metadata:
      m_Items: []
  - m_Id: 3882246725634
    m_Key: A random general tips.
    m_Metadata:
      m_Items: []
  - m_Id: 3882246725635
    m_Key: These career ladies are willing to wait in line a bit longer, but will
      tip less.
    m_Metadata:
      m_Items: []
  - m_Id: 3882246725636
    m_Key: Let's tidy up this room.
    m_Metadata:
      m_Items: []
  - m_Id: 3882246725637
    m_Key: He is half-way to becoming world famous, hence his cocky attitude. He
      pays good money though, so we should serve him with a smile.
    m_Metadata:
      m_Items: []
  - m_Id: 3882246725638
    m_Key: Special Customer!
    m_Metadata:
      m_Items: []
  - m_Id: 3882246725639
    m_Key: International famous food critic! His reviews are usually harsh and he
      can really make or break a business. Loved by foodies, dreaded by restaurant
      managers.
    m_Metadata:
      m_Items: []
  - m_Id: 3882246725640
    m_Key: Old, tired and full of interesting war stories. Listen to his stories
      as you serve him and you might get a generous tip.
    m_Metadata:
      m_Items: []
  - m_Id: 3882246725641
    m_Key: Making Yogurt
    m_Metadata:
      m_Items: []
  - m_Id: 3882246725642
    m_Key: Let's make some froyo!!
    m_Metadata:
      m_Items: []
  - m_Id: 3882246725643
    m_Key: Fairly patient and always in a good mood. Love her and she will love you
      back by giving you a generous tip.
    m_Metadata:
      m_Items: []
  - m_Id: 3882246725644
    m_Key: Had training all her life to keep smiling no matter what happens, including
      when she has to queue very long. Does not tips as good, though.
    m_Metadata:
      m_Items: []
  - m_Id: 3882246725645
    m_Key: A very famous figure back in his country, so he gets impatient when being
      told to queue. Will tip pretty good.
    m_Metadata:
      m_Items: []
  - m_Id: 3882246725646
    m_Key: Has full schedule throughout each week, does not want to wait for long.
      Tips fairly good.
    m_Metadata:
      m_Items: []
  - m_Id: 3882246725647
    m_Key: "Made big money by chasing bad guys in action movies, he\u2019ll tip very
      good if treated exceptionally well."
    m_Metadata:
      m_Items: []
  - m_Id: 3882246725648
    m_Key: "Being one of the richest people in the world does pay! She\u2019ll leave
      if not treated well, but will tip lots when her high standards are met."
    m_Metadata:
      m_Items: []
  m_Metadata:
    m_Items: []
