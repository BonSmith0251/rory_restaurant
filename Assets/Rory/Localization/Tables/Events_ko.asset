  m_SharedData: {fileID: 11400000, guid: c451a22b809da524bab65eb1e1fc7a66, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 3882234142720
    m_Localized: "\uC774 \uADC0\uC5EC\uC6B4 \uC544\uC774\uB294 \uC58C\uC804\uD788
      \uC904\uC744 \uC11C\uC11C \uAE30\uB2E4\uB9AC\uACE0 \uBC14\uB77C\uB294 \uAC83\uB3C4
      \uBCC4\uB85C \uC5C6\uC5B4\uC694. \uCD5C\uACE0\uC758 \uC190\uB2D8\uC774\uC8E0!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882246725632
    m_Localized: "\uBC1D\uAC8C \uC6C3\uB294 \uC18C\uB144\uC774 \uC6B0\uB9AC \uAC00\uAC8C\uC5D0\uC11C
      \uC58C\uC804\uD788 \uC904 \uC11C \uC788\uB294 \uBAA8\uC2B5\uB9CC\uD07C \uC88B\uC740
      \uAC74 \uC5C6\uC8E0!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882246725633
    m_Localized: "\uC0AC\uC5C5\uAC00\uB294 \uC77C\uC815\uC774 \uBC14\uBE60\uC11C
      \uBE68\uB9AC \uB300\uC811\uD558\uBA74 \uB3C8\uC744 \uB354 \uB9CE\uC774 \uB0BC
      \uAC70\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3882246725634
    m_Localized: "\uBB34\uC791\uC704 \uC77C\uBC18 \uD301."
    m_Metadata:
      m_Items: []
  - m_Id: 3882246725635
    m_Localized: "\uC774 \uC9C1\uC7A5\uC778 \uC5EC\uC131\uB4E4\uC740 \uC870\uAE08
      \uB354 \uC624\uB798 \uC904\uC744 \uC11C \uC8FC\uC9C0\uB9CC \uD301\uC740 \uC801\uAC8C
      \uC918\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3882246725636
    m_Localized: "\uC774 \uBC29\uC744 \uC815\uB9AC\uD574 \uBD10\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3882246725637
    m_Localized: "\uC138\uACC4\uC801\uC778 \uC2A4\uD0C0\uAC00 \uB418\uAE30 \uC9C1\uC804\uC774\uB77C
      \uC880 \uAC74\uBC29\uC838\uC694. \uADF8\uB798\uB3C4 \uB3C8\uC744 \uC798 \uB0B4\uB2C8\uAE4C
      \uC6C3\uC73C\uBA70 \uB300\uC811\uD574\uC57C \uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3882246725638
    m_Localized: "\uD2B9\uBCC4\uD55C \uC190\uB2D8!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882246725639
    m_Localized: "\uC138\uACC4\uC801\uC73C\uB85C \uC720\uBA85\uD55C \uC74C\uC2DD
      \uD3C9\uB860\uAC00! \uD3C9\uAC00\uAC00 \uB300\uCCB4\uB85C \uD639\uB3C5\uD574\uC11C
      \uAC00\uAC8C\uB97C \uC0B4\uB9AC\uAE30\uB3C4 \uB9DD\uCE58\uAE30\uB3C4 \uD574\uC694.
      \uBBF8\uC2DD\uAC00\uB4E4\uC5D0\uAC90 \uC0AC\uB791\uBC1B\uACE0 \uB808\uC2A4\uD1A0\uB791
      \uC0AC\uC7A5\uB4E4\uC5D0\uAC90 \uB450\uB824\uC6B4 \uC874\uC7AC\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 3882246725640
    m_Localized: "\uB098\uC774 \uB4E4\uACE0 \uC9C0\uCCE4\uC9C0\uB9CC \uC7AC\uBBF8\uC788\uB294
      \uC804\uC7C1 \uC774\uC57C\uAE30\uAC00 \uAC00\uB4DD\uD574\uC694. \uB300\uC811\uD558\uBA74\uC11C
      \uC774\uC57C\uAE30\uB97C \uB4E4\uC5B4 \uC8FC\uBA74 \uD301\uC744 \uB109\uB109\uD788
      \uC904\uC9C0\uB3C4 \uBAB0\uB77C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3882246725641
    m_Localized: "\uC694\uAC70\uD2B8 \uB9CC\uB4E4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 3882246725642
    m_Localized: "\uD504\uB85C\uC98C \uC694\uAC70\uD2B8\uB97C \uB9CC\uB4E4\uC5B4
      \uBD10\uC694!!"
    m_Metadata:
      m_Items: []
  - m_Id: 3882246725643
    m_Localized: "\uAF64 \uCC38\uC744\uC131 \uC788\uACE0 \uB298 \uAE30\uBD84\uC774
      \uC88B\uC544\uC694. \uC798\uD574 \uC8FC\uBA74 \uB109\uB109\uD55C \uD301\uC73C\uB85C
      \uBCF4\uB2F5\uD560 \uAC70\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3882246725644
    m_Localized: "\uBB34\uC2A8 \uC77C\uC774 \uC788\uC5B4\uB3C4 \uC6C3\uB3C4\uB85D
      \uD3C9\uC0DD \uD6C8\uB828\uD574 \uC654\uC5B4\uC694. \uC624\uB798 \uC904\uC744
      \uC11C\uC57C \uD560 \uB54C\uB3C4\uC694. \uD558\uC9C0\uB9CC \uD301\uC740 \uADF8\uB9AC
      \uB9CE\uC774 \uC8FC\uC9C0 \uC54A\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3882246725645
    m_Localized: "\uC790\uAE30 \uB098\uB77C\uC5D0\uC11C\uB294 \uC544\uC8FC \uC720\uBA85\uD55C
      \uC778\uBB3C\uC774\uB77C \uC904\uC744 \uC11C\uB77C\uACE0 \uD558\uBA74 \uAE08\uBC29
      \uC9DC\uC99D\uC744 \uB0B4\uC694. \uD301\uC740 \uAF64 \uC798 \uC918\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3882246725646
    m_Localized: "\uB9E4\uC8FC \uC77C\uC815\uC774 \uAF49 \uCC28 \uC788\uC5B4\uC11C
      \uC624\uB798 \uAE30\uB2E4\uB9AC\uAE30 \uC2EB\uC5B4\uD574\uC694. \uD301\uC740
      \uAF64 \uC798 \uC918\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3882246725647
    m_Localized: "\uC561\uC158 \uC601\uD654\uC5D0\uC11C \uC545\uB2F9\uC744 \uCAD3\uC544
      \uD070\uB3C8\uC744 \uBC88 \uBC30\uC6B0\uC608\uC694. \uC544\uC8FC \uD2B9\uBCC4\uD558\uAC8C
      \uB300\uC811\uD558\uBA74 \uD301\uC744 \uC815\uB9D0 \uB9CE\uC774 \uC904 \uAC70\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3882246725648
    m_Localized: "\uC138\uACC4 \uCD5C\uACE0 \uBD80\uC790 \uC911 \uD55C \uBA85\uC774\uB77C\uB294
      \uAC74 \uC5ED\uC2DC \uC88B\uC740 \uC77C\uC774\uC8E0! \uB300\uC811\uC774 \uBCC4\uB85C\uBA74
      \uB5A0\uB098\uC9C0\uB9CC, \uB192\uC740 \uAE30\uC900\uC744 \uB9CC\uC871\uC2DC\uD0A4\uBA74
      \uD301\uC744 \uB4EC\uBFCD \uC918\uC694."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
