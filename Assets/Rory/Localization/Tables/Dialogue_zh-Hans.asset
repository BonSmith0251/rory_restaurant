      m_Items: []
  - m_Id: 3882406109210
    m_Localized: "\u592A\u597D\u4E86\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109211
    m_Localized: "\u53E6\u5916\uFF0C\u5347\u7EA7\u98DF\u8C31\u4F1A\u63D0\u9AD8\u83DC\u54C1\u7684\u4EF7\u503C\u3002\u83DC\u8D8A\u8D35\uFF0C\u6211\u4EEC\u8D5A\u5F97\u5C31\u8D8A\u591A\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109212
    m_Localized: "\u8BB0\u5F97\u53EA\u8981\u94B1\u591F\u4E86\uFF0C\u968F\u65F6\u90FD\u53EF\u4EE5\u53BB\u5546\u5E97\u901B\u901B\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109213
    m_Localized: "\u770B\u770B\u8FD9\u4E71\u4E03\u516B\u7CDF\u7684\u6837\u5B50\uFF01\u8C01\u80FD\u60F3\u5230\u6211\u4EEC\u90A3\u4E9B\u7F8E\u5473\u7684\u83DC\u5C31\u662F\u5728\u8FD9\u4E2A\u53A8\u623F\u91CC\u505A\u51FA\u6765\u7684\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109214
    m_Localized: "\u6CA1\u4EBA\u4F1A\u4FE1"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109215
    m_Localized: "\u5927\u5BB6\u90FD\u8BF4\u53A8\u623F\u8981\u968F\u65F6\u4FDD\u6301\u5E72\u51C0\u6574\u6D01\uFF0C\u5BF9\u5427\uFF1F\u8FD9\u8BDD\u4E00\u70B9\u6CA1\u9519\uFF0C\u56E0\u4E3A\u5728\u8FD9\u4E48\u4E71\u7684\u5730\u65B9\u6839\u672C\u6CA1\u6CD5\u505A\u996D\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109216
    m_Localized: "\u6211\u77E5\u9053\u4F60\u548C\u6211\u4E00\u6837\u7231\u505A\u996D\uFF0C\u4F46\u6211\u4EEC\u5F97\u5148\u628A\u8FD9\u91CC\u6536\u62FE\u5E72\u51C0\uFF01\u8D8A\u65E9\u5F04\u5B8C\u8D8A\u597D\u3002\u5F00\u59CB\u5427\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109217
    m_Localized: "\u6211\u4EEC\u5F97\u628A\u53A8\u623F\u91CC\u7684\u5927\u90E8\u5206\u4E1C\u897F\u90FD\u6E05\u7406\u6389\u3002\u6211\u51C6\u5907\u597D\u4E86\u7269\u54C1\u6E05\u5355\uFF0C\u8FD9\u6837\u5C31\u7B80\u5355\u591A\u4E86\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109218
    m_Localized: "\u5C31\u662F\u5B83\uFF0C\u6E05\u5355\u4E0A\u7684\u7B2C\u4E00\u4EF6\u7269\u54C1\u3002\u70B9\u51FB\u5B83\u5C31\u80FD\u62FF\u8D70\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109219
    m_Localized: "\u592A\u597D\u4E86\uFF01\u73B0\u5728\uFF0C\u8BD5\u7740\u7528\u63D0\u793A\u6765\u627E\u7B2C\u4E8C\u4EF6\u7269\u54C1\u5427\u3002\u70B9\u8FD9\u91CC\u4F7F\u7528\u63D0\u793A\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109220
    m_Localized: "\u63D0\u793A\u4F1A\u6162\u6162\u6062\u590D\uFF0C\u6240\u4EE5\u4F60\u53EF\u4EE5\u53CD\u590D\u4F7F\u7528\u3002\u5F88\u8D34\u5FC3\u5427\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109221
    m_Localized: "\u662F\u7684\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109222
    m_Localized: "\u6700\u540E\u4E00\u4E2A\u5C0F\u63D0\u793A\uFF1A\u6309\u4F4F CTRL
      \u952E\u62D6\u52A8\u9F20\u6807\uFF0C\u5C31\u53EF\u4EE5\u653E\u5927\u548C\u7F29\u5C0F\u753B\u9762\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109223
    m_Localized: "\u73B0\u5728\u8BD5\u7740\u81EA\u5DF1\u627E\u51FA\u5269\u4E0B\u7684\u7269\u54C1\u5427\u3002\u795D\u4F60\u597D\u8FD0\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109224
    m_Localized: "\u6BCF\u4F4D\u987E\u5BA2\u7684\u6027\u683C\u90FD\u4E0D\u4E00\u6837\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109225
    m_Localized: "\u6709\u4E9B\u4EBA\u6BD4\u8F83\u6709\u8010\u5FC3\u4F46\u5C0F\u8D39\u7ED9\u5F97\u5C11\uFF0C\u6709\u4E9B\u4EBA\u6392\u961F\u65F6\u5BB9\u6613\u4E0D\u8010\u70E6\uFF0C\u4F46\u5C0F\u8D39\u7ED9\u5F97\u591A\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109226
    m_Localized: "\u5408\u7406\u5B89\u6392\u4F18\u5148\u987A\u5E8F\uFF0C\u8BA9\u4E00\u5929\u7684\u5229\u6DA6\u6700\u5927\u5316\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109227
    m_Localized: "(player)\uFF0C\u542C\u8BF4\u4ECA\u5929\u6709\u4E00\u4F4D\u7F8E\u98DF\u8BC4\u8BBA\u5BB6\u8981\u6765\uFF01\u5929\u54EA\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109228
    m_Localized: "\u542C\u8BF4\u7F8E\u98DF\u8BC4\u8BBA\u5BB6\u662F\u6700\u96BE\u4F3A\u5019\u7684\u987E\u5BA2\uFF01\u4ED6\u4EEC\u901A\u5E38\u4F1A\u70B9\u9910\u5385\u6700\u597D\u7684\u83DC\uFF0C\u8FD8\u8981\u6C42\u5FEB\u70B9\u4E0A\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109229
    m_Localized: "\u4ECA\u5929\u4E00\u5B9A\u8981\u8BA9\u4E00\u5207\u987A\u987A\u5229\u5229\uFF01\u6211\u4EEC\u5168\u529B\u4EE5\u8D74\u5427\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109230
    m_Localized: "\u4ED6\u6765\u4E86\uFF01\u90A3\u4F4D\u51FA\u4E86\u540D\u7684\u3001\u4E00\u8138\u4E0D\u9AD8\u5174\u7684\u7F8E\u98DF\u8BC4\u8BBA\u5BB6\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109231
    m_Localized: "\u4ED6\u521A\u70B9\u4E86\u6211\u4EEC\u6700\u8D35\u7684\u83DC\uFF0C\u8FD8\u8981\u6BCF\u6837\u914D\u6599\u90FD\u52A0\u91CF\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109232
    m_Localized: "\u6211\u4EEC\u771F\u7684\u9700\u8981\u4ED6\u7ED9\u4E2A\u597D\u8BC4\uFF0C\u6240\u4EE5\u52AA\u529B\u6EE1\u8DB3\u4ED6\u7684\u6240\u6709\u8981\u6C42\u5427\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109233
    m_Localized: "\u8BB0\u4F4F\uFF1A\u70B9\u51FB\u7F8E\u98DF\u8BC4\u8BBA\u5BB6\u7684\u76D8\u5B50\uFF0C\u5C31\u80FD\u628A\u4ED6\u7684\u8BA2\u5355\u8BBE\u4E3A\u6700\u4F18\u5148\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109234
    m_Localized: "\u4ECA\u5929\u5E72\u5F97\u771F\u6F02\u4EAE\uFF01\u6211\u592A\u5F00\u5FC3\u4E86\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109235
    m_Localized: "\u8FD8\u60F3\u542C\u66F4\u591A\u597D\u6D88\u606F\u5417\uFF1F\u731C\u731C\u770B\uFF0C\u6211\u521A\u627E\u5230\u4E00\u672C\u4E2D\u5F0F\u83DC\u8C31\u7684\u8001\u98DF\u8C31\uFF01\u5F88\u5389\u5BB3\u5427\uFF1F"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109236
    m_Localized: "\u6211\u77E5\u9053\u4F60\u5DF2\u7ECF\u8FEB\u4E0D\u53CA\u5F85\u60F3\u8BD5\u8BD5\u4E86\uFF0C\u51C6\u5907\u597D\u4E86\u5C31\u53BB\u53A8\u623F\u5427\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109237
    m_Localized: "\u606D\u559C\uFF0C\u73B0\u5728\u4F60\u53EF\u4EE5\u505A\u4E00\u6574\u5957\u7F8E\u5473\u7684\u4E2D\u5F0F\u4F73\u80B4\u4E86\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109238
    m_Localized: "\u8BB0\u4F4F\uFF0C\u4F60\u968F\u65F6\u53EF\u4EE5\u5728\u5546\u5E97\u8D2D\u4E70\u65B0\u98DF\u8C31\u3001\u5347\u7EA7\u98DF\u6750\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 3882406109239
    m_Localized: "\u563F\uFF0C\u731C\u731C\u8C01\u521A\u5F00\u4E86\u4E00\u5BB6\u6709\u673A\u5E02\u573A\uFF1F\u53C8\u662F\u827E\u739B\uFF01"
