    - proceedType: button
      buttonText: OK!
      posX: 512
      posY: 300
      hasArrow: 0
      arrowX: 0
      arrowY: 0
      arrowDirection: -1
      blockNext: 0
      text: "Come, I\u2019ll walk you through this!"
    - proceedType: button
      buttonText: Next
      posX: 512
      posY: 300
      hasArrow: 0
      arrowX: 0
      arrowY: 0
      arrowDirection: -1
      blockNext: 1
      text: "I have prepared everything from cups to yogurts so we\u2019re all set
