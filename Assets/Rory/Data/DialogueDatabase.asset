    - proceedType: button
      buttonText: Next
      posX: 512
      posY: 300
      hasArrow: 0
      arrowX: 0
      arrowY: 0
      arrowDirection: -1
      blockNext: 0
      text: "We really need a good review from him so let\u2019s work hard to serve
