    - proceedType: button
      buttonText: Next
      posX: 512
      posY: 300
      hasArrow: 0
      arrowX: 0
      arrowY: 0
      arrowDirection: -1
      blockNext: 0
      text: "I heard food critics are the worst kind of customer! They usually order
