    - proceedType: button
      buttonText: OK!
      posX: 512
      posY: 300
      hasArrow: 0
      arrowX: 0
      arrowY: 0
      arrowDirection: -1
      blockNext: 0
      text: Set your priorities to get maximum profit out of your day.
  - lines:
    - proceedType: button
      buttonText: Next
      posX: 512
      posY: 300
      hasArrow: 0
      arrowX: 0
      arrowY: 0
      arrowDirection: -1
      blockNext: 0
