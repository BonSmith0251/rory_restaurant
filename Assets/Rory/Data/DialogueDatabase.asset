    - proceedType: button
      buttonText: OK!
      posX: 512
      posY: 300
      hasArrow: 0
      arrowX: 0
      arrowY: 0
      arrowDirection: -1
      blockNext: 0
      text: "And remember: Click the food critic\u2019s plate to make his order the
