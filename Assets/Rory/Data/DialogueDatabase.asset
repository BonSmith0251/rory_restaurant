    - proceedType: button
      buttonText: Yes!
      posX: 512
      posY: 300
      hasArrow: 0
      arrowX: 0
      arrowY: 0
      arrowDirection: -1
      blockNext: 0
      text: "Hints will refill slowly so you can use it over and over again. Very
