    - proceedType: button
      buttonText: Next
      posX: 512
      posY: 300
      hasArrow: 1
      arrowX: 100
      arrowY: 0
      arrowDirection: -1
      blockNext: 0
      text: There he is! The notorious, sour-looking food critic!
    - proceedType: button
      buttonText: Next
      posX: 512
      posY: 300
      hasArrow: 0
      arrowX: 0
      arrowY: 0
      arrowDirection: -1
      blockNext: 0
