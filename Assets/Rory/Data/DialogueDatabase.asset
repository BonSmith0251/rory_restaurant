  m_Script: {fileID: 11500000, guid: 7a7af8f63f1e76b469306e6422a149eb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogues:
  - lines:
    - proceedType: button
      buttonText: Next
      posX: 512
      posY: 300
      hasArrow: 0
      arrowX: 0
      arrowY: 0
      arrowDirection: -1
      blockNext: 0
      text: Finally, the days of my culinary school are over!
    - proceedType: button
      buttonText: Next
      posX: 512
      posY: 300
      hasArrow: 0
      arrowX: 0
      arrowY: 0
      arrowDirection: -1
      blockNext: 0
      text: Now I have all day to focus on my work as certified chef!
    - proceedType: button
      buttonText: Next
      posX: 512
      posY: 300
      hasArrow: 0
      arrowX: 0
      arrowY: 0
      arrowDirection: -1
      blockNext: 0
      text: "I have been thinking of opening a shop since the first day at culinary
        school. I\u2019m so excited the time has come!"
    - proceedType: button
      buttonText: Of course!
      posX: 512
      posY: 300
      hasArrow: 0
      arrowX: 0
      arrowY: 0
      arrowDirection: -1
      blockNext: 0
      text: I will need someone to accompany me. Will you help me out?
    - proceedType: action
      buttonText: 
      posX: 512
      posY: 300
      hasArrow: 1
      arrowX: 450
      arrowY: 470
      arrowDirection: 1
      blockNext: 0
      text: "That\u2019s the spirit! Now, let\u2019s start our first day!"
  - lines:
    - proceedType: button
      buttonText: OK!
      posX: 512
      posY: 300
      hasArrow: 0
      arrowX: 0
      arrowY: 0
      arrowDirection: -1
      blockNext: 0
      text: Welcome to my kitchen! Let me give you a tour!
    - proceedType: button
      buttonText: Continue
      posX: 512
      posY: 300
      hasArrow: 1
      arrowX: 350
      arrowY: 20
      arrowDirection: -1
      blockNext: 1
      text: Your objective is to earn enough money by cooking delicious food. This
        is the amount of customers you need to serve today.
    - proceedType: button
      buttonText: Continue
      posX: 512
      posY: 300
      hasArrow: 1
      arrowX: 270
      arrowY: 110
      arrowDirection: -1
      blockNext: 0
      text: A customer has come! Here is the list of ingredients you need to complete
        the dish.
    - proceedType: action
      buttonText: 
      posX: 250
      posY: 480
      hasArrow: 0
      arrowX: 0
      arrowY: 0
      arrowDirection: -1
      blockNext: 0
      text: Swap and make a match of at least 3 ingredients.
    - proceedType: button
      buttonText: OK!
      posX: 512
      posY: 300
      hasArrow: 0
      arrowX: 0
      arrowY: 0
      arrowDirection: -1
      blockNext: 1
      text: Great! Now continue to match more ingredients to complete the dish.
    - proceedType: action
      buttonText: 
      posX: 512
      posY: 300
      hasArrow: 1
      arrowX: 270
      arrowY: 110
      arrowDirection: -1
      blockNext: 0
      text: Congratulations! You have finished your first dish! Now click on the
        Money to collect it.
    - proceedType: button
      buttonText: Ok
      posX: 512
      posY: 300
      hasArrow: 0
      arrowX: 0
      arrowY: 0
      arrowDirection: -1
      blockNext: 1
      text: "Please keep in mind to check out each customer\u2019s patient meter.
        They will leave more tips for you when they are happier!"
    - proceedType: action
      buttonText: 
      posX: 650
      posY: 400
      hasArrow: 1
      arrowX: 400
      arrowY: 240
      arrowDirection: -1
      blockNext: 0
      text: 'One more thing I need to tell you: When you have more than 1 customer
        at a time, click on their plate to change priority.'
    - proceedType: button
      buttonText: No problem!
      posX: 512
      posY: 300
      hasArrow: 0
      arrowX: 0
      arrowY: 0
      arrowDirection: -1
      blockNext: 0
      text: "I think we\u2019re all set! Let\u2019s keep our customers coming and
        serve them well!"
  - lines:
    - proceedType: button
      buttonText: Next
      posX: 512
      posY: 300
      hasArrow: 0
      arrowX: 0
      arrowY: 0
      arrowDirection: -1
      blockNext: 0
      text: Great job, (player)! I must say that we did really great yesterday!
    - proceedType: action
      buttonText: 
      posX: 512
      posY: 200
      hasArrow: 1
      arrowX: 450
      arrowY: 470
      arrowDirection: 1
      blockNext: 0
      text: I can't wait to cook already! Let's start now!
  - lines:
    - proceedType: button
      buttonText: Cool!
      posX: 512
      posY: 300
      hasArrow: 0
      arrowX: 0
      arrowY: 0
      arrowDirection: -1
      blockNext: 0
      text: Good news! Do you know Emma, that famous girl in the Home Makeover games?
        Well, she just came into town to set up a book store!
    - proceedType: action
      buttonText: 
      posX: 650
      posY: 300
      hasArrow: 1
      arrowX: 250
      arrowY: 210
      arrowDirection: 1
      blockNext: 0
      text: Now we can buy new recipes and upgrade our old ones! Click here to open
        our recipe book!
    - proceedType: button
      buttonText: OK!
      posX: 512
      posY: 400
      hasArrow: 1
      arrowX: 660
      arrowY: 510
      arrowDirection: -1
      blockNext: 0
      text: "Why don\u2019t we try to buy the Deluxe Chicken Croissant recipe?"
    - proceedType: action
      buttonText: 
      posX: 512
      posY: 450
      hasArrow: 1
      arrowX: 750
      arrowY: 300
      arrowDirection: -1
      blockNext: 0
      text: Click here to see the next recipe in the list.
    - proceedType: action
      buttonText: 
      posX: 512
      posY: 400
      hasArrow: 1
      arrowX: 540
      arrowY: 568
      arrowDirection: 1
      blockNext: 0
      text: Click this button to buy it!
    - proceedType: button
      buttonText: Great!
      posX: 512
      posY: 300
      hasArrow: 0
      arrowX: 0
      arrowY: 0
      arrowDirection: -1
      blockNext: 0
      text: Awesome! We just bought a new recipe! Keep buying better ones to increase
        our restaurant reputation!
    - proceedType: button
      buttonText: Next
      posX: 512
      posY: 300
      hasArrow: 0
      arrowX: 0
      arrowY: 0
      arrowDirection: -1
      blockNext: 0
      text: Also, upgrading recipes will increase value of the dish. The more expensive
        it gets, the more money we will earn!
    - proceedType: button
      buttonText: OK!
      posX: 512
      posY: 300
      hasArrow: 0
      arrowX: 0
      arrowY: 0
      arrowDirection: -1
      blockNext: 0
      text: Remember to visit the Shops anytime you have enough money!
  - lines:
    - proceedType: button
      buttonText: No one
      posX: 512
      posY: 300
      hasArrow: 0
      arrowX: 0
      arrowY: 0
      arrowDirection: -1
      blockNext: 0
      text: Look at this incredible mess! Who would have thought that we cooked our
        delicious dishes here in this very kitchen?
    - proceedType: button
      buttonText: Right
      posX: 512
      posY: 300
      hasArrow: 0
      arrowX: 0
      arrowY: 0
      arrowDirection: -1
      blockNext: 0
      text: "You know what they say about always try to have your kitchen clean and
        tidy, right? Well, that\u2019s quite true because you can\u2019t cook in
        this mess."
    - proceedType: button
      buttonText: OK!
      posX: 512
      posY: 300
      hasArrow: 0
      arrowX: 0
      arrowY: 0
      arrowDirection: -1
      blockNext: 0
      text: "I know you like cooking as much as I do but we still need to clean this
        up first! The sooner we get this done, the better. Let\u2019s start!"
    - proceedType: button
      buttonText: OK!
      posX: 512
      posY: 300
      hasArrow: 0
      arrowX: 0
      arrowY: 0
      arrowDirection: -1
      blockNext: 0
      text: We need to remove most of these items from the kitchen. I have provided
        the list of items so this will be easy!
    - proceedType: action
      buttonText: 
      posX: 512
      posY: 450
      hasArrow: 1
      arrowX: 0
      arrowY: 0
      arrowDirection: 1
      blockNext: 0
      text: There it is, the first item on top of the list. Just click to grab it.
    - proceedType: action
      buttonText: 
      posX: 512
      posY: 300
      hasArrow: 1
      arrowX: 870
      arrowY: 70
      arrowDirection: 1
      blockNext: 0
      text: "Great! Now, let\u2019s try to use a hint for the second item. Click
