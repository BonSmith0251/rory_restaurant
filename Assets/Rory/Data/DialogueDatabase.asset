    - proceedType: button
      buttonText: Next
      posX: 512
      posY: 300
      hasArrow: 0
      arrowX: 0
      arrowY: 0
      arrowDirection: -1
      blockNext: 0
      text: 'Last tip: you can zoom in and out by dragging your mouse while holding
