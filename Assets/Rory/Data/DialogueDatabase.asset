    - proceedType: button
      buttonText: OK!
      posX: 512
      posY: 300
      hasArrow: 0
      arrowX: 0
      arrowY: 0
      arrowDirection: -1
      blockNext: 1
      text: "We must make sure everything goes very well today! Let\u2019s do our
